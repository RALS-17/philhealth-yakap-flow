# Copy this file to ".env" (same folder as package.json) and fill in the values.
# Each branch uses ITS OWN Supabase account/project.
# Supabase -> Project Settings -> API: "Project URL" and the "anon" / "publishable" key.
# NEVER use the service_role / secret key here.

# Cabuyao (/cabuyao)
VITE_GCMCL_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_GCMCL_SUPABASE_ANON_KEY=

# Canlubang (/canlubang)
VITE_GCMCC_SUPABASE_URL=https://yyyyyyyy.supabase.co
VITE_GCMCC_SUPABASE_ANON_KEY=
